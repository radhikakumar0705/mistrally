# Copy to backend/.env for running the backend directly (python app.py).
# Docker Compose and Kubernetes use their own settings (../.env, k8s/).
# Generate secrets with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
# Browser path of the refresh endpoint (the frontend reaches the API under /api)
JWT_REFRESH_COOKIE_PATH=/api/auth/
# Set to true when served over HTTPS
COOKIE_SECURE=False

# Google sign-in (optional). Redirect URI to register in Google Cloud Console:
#   <PUBLIC_URL>/api/auth/google/callback
PUBLIC_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mistrally
# Or a full SQLAlchemy URL instead of the DB_* values:
# DATABASE_URL=mysql+mysqlconnector://user:pass@localhost/mistrally

# Model backend: ollama | groq | openai | fake
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_MODELS=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT=120

# Chroma: on-disk store by default; set CHROMA_HOST to use a Chroma server instead
CHROMA_DB_PATH=./chroma_db
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
RAG_TOP_K=4
RAG_MAX_DISTANCE=1.4

MAX_UPLOAD_MB=10

# Retrieval: hybrid (BM25 + embeddings) or dense; cross-encoder re-ranking (see docs/rag-evaluation.md)
RAG_MODE=hybrid
RAG_RERANK=true

# Background document processing: set to a Redis URL and run `python worker.py`;
# leave empty to process uploads inside the request
TASK_QUEUE_URL=

# Rate limits are per process with memory://; use redis://host:6379/0 to share them
RATELIMIT_STORAGE_URI=memory://
# Only needed if the frontend calls the API from another origin (the Vite proxy makes this unnecessary)
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
DEBUG=False
