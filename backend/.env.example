# Copy to backend/.env and fill in. Generate secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=
JWT_EXPIRES_HOURS=12

DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_NAME=mistrally
# Or set a full SQLAlchemy URL instead of the DB_* values:
# DATABASE_URL=mysql+mysqlconnector://user:pass@localhost/mistrally

CORS_ORIGINS=http://localhost:3000

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT=120

CHROMA_DB_PATH=./chroma_db
UPLOAD_FOLDER=./data/uploads
MAX_UPLOAD_MB=10

DEBUG=False
