# Docker Compose settings. Copy to .env and fill in.
# Generate secrets with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Model backend: ollama (default), groq (hosted demo), openai, or fake (canned answers, no LLM needed)
LLM_PROVIDER=ollama
# For groq: a free API key from https://console.groq.com/keys
GROQ_API_KEY=
# Optional: default model and the models offered in the picker (comma-separated)
LLM_MODEL=
LLM_MODELS=

# Ollama on your machine (default) or in Compose (--profile ollama, then http://ollama:11434)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral

# Monitoring profile: send traces to Jaeger (docker compose --profile monitoring up)
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=

# Host port for the web app, and the URL people use to reach it
MISTRALLY_PORT=8090
PUBLIC_URL=http://localhost:8090
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# Optional: Google sign-in. Create an OAuth client (type "Web application") in Google Cloud Console
# with the redirect URI  <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
