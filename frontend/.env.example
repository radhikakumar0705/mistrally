# Optional. By default the app calls same-origin /api (proxied to Flask by Vite in
# development and by nginx in Docker/Kubernetes). Set this only to call another URL.
# VITE_API_URL=http://127.0.0.1:5000

# Where the Vite dev server proxies /api to (default http://127.0.0.1:5000)
# VITE_BACKEND_URL=http://127.0.0.1:5000
